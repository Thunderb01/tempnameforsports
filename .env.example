# Copy this file to .env.local and fill in your real values.
# .env.local is gitignored — never commit real credentials.

# ── Frontend (Vite) ─────────────────────────────────────────────────────────
# Find these at: Supabase dashboard → Settings → API
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_ANON_KEY_HERE

# ── Python pipeline scripts (torvik_metrics.py, run_season_pipeline.py, …) ──
# Same values as above, unprefixed, plus the service-role key (not the anon
# key) since these scripts write to Supabase directly.
# Picked up automatically by run_season_pipeline.py (and passed through to
# every script it runs as a subprocess) if python-dotenv is installed:
#   pip install python-dotenv
# Without python-dotenv installed, set these in your shell instead:
#   PowerShell: $env:SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key
